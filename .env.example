# Copy this file to .env and edit the values.
DATABASE_URL=postgresql://postgres:root@127.0.0.1:5432/fileshare_db
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
MAX_FILE_SIZE_GB=10

# Razorpay TEST MODE credentials from your Razorpay dashboard.
# Leave blank to run the app without enabling checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
APP_BASE_URL=http://127.0.0.1:8000
